# Copy to .env and fill in. Used for Claude reflections + the poetry taste gate.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# EVERYDAYPASSION_MODEL=claude-opus-4-8          # writes the reflections
# EVERYDAYPASSION_GATE_MODEL=claude-haiku-5-5    # the poem taste check (YES/NO)
# EVERYDAYPASSION_CONTACT=you@example.com        # User-Agent contact; defaults to the repo URL
# EVERYDAYPASSION_HOME=~/.everydaypassion
# EVERYDAYPASSION_IDLE_SECONDS=1800
